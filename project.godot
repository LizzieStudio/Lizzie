run/main_scene="uid://caj4d7v430lhp"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="uid://dtoajk1ds5abr"

[autoload]

ProjectService="*uid://cxbjtcxn44v75"
Utility="*res://Scenes/Utility.tscn"
EventBus="*uid://dg3sv0bbkjbc2"
MultiplayerManager="*uid://bdusjpa55red6"
EventSynchronizer="*uid://cmji5njsmymf0"
RecordService="*uid://oanp50dr5urb"
PresenceSynchronizer="*uid://djqhbflqj1i2f"
Config="*uid://diprp4p2jdstg"
DebugConsole="*uid://dg13x5vbxhq7d"
ImGuiRoot="*uid://dugmpnsxaagba"

[display]

window/size/extend_to_title=true
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="Lizzie"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/imgui-godot/plugin.cfg", "res://addons/label_font_auto_sizer/plugin.cfg")

